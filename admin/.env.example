# Base URL of the ALRT backend Admin API (backend/src/routes/admin).
# No trailing slash. The portal calls ${VITE_API_BASE_URL}/api/admin/...
# Never put secrets in this file - only the backend's own env vars
# (backend/.env.dev, never committed) hold credentials.
VITE_API_BASE_URL=http://localhost:3000

# Firebase Web config for the Ask ALRT admin page (src/lib/firebase.ts).
# These are Firebase's public web-app identifiers (safe to ship, not
# secrets - Firebase's own docs are explicit about this), but a Firebase
# Web App for this project does not exist yet, so they are intentionally
# blank here. The Ask ALRT page detects a blank config and shows a clear
# "not configured" state instead of attempting a broken Firebase call -
# see AskAlrtPage.tsx / lib/firebase.ts. Fill these in only once a Firebase
# Web App has actually been registered in the Firebase console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# App Check site key (reCAPTCHA v3) for the same not-yet-created Web App.
# Also blank until that Firebase Console step is done - see the Ask ALRT
# page's "not configured" state.
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# TEST-only "Create Dummy Alert" button on the Alerts page - see
# AlertsPage.tsx. Leave blank/unset here and in every production env
# file; only admin/.env.test sets this to "true".
VITE_ENABLE_DUMMY_ALERTS=

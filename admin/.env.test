# Admin Portal build-time config for the ISOLATED INTERNAL-TEST environment
# only (Stage A, V1_RECONCILIATION_REPORT.md). Loaded automatically by Vite
# when building with --mode test (see the "build:test" script in
# package.json). Never used by the production build ("npm run build",
# no --mode flag, loads .env.production/.env if present - unaffected by
# this file).
#
# PROPOSED domain, not yet real: this hostname does not point at anything
# deployed yet. It is a naming proposal only, matching the existing
# api.safetyalrt.com convention. Replace with the real test backend's
# actual URL once it exists (Stage A item 1), or leave as-is and register
# this exact domain for it.
VITE_API_BASE_URL=https://api-test.safetyalrt.com

# TEST-only: shows the "Create Dummy Alert" button on the Alerts page.
# Deliberately not in .env.example or any production env file - a
# production build has this unset, so the button doesn't exist in that
# build at all, not just hidden. See AlertsPage.tsx.
VITE_ENABLE_DUMMY_ALERTS=true

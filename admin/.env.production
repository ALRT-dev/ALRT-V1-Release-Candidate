# Admin Portal build settings for the LIVE portal (admin.safetyalrt.com).
# Loaded automatically by `npm run build` (Vite's default "production" mode).
# Public values only - nothing here is a secret, and none may ever be added.

# Live backend Admin API. No trailing slash.
VITE_API_BASE_URL=https://api.safetyalrt.com

# TEST-only buttons stay OFF in the live portal. Do not change.
VITE_ENABLE_DUMMY_ALERTS=
VITE_ENABLE_REAL_SOURCE_SYNC=

# Ask ALRT answers, emergency numbers and the AI switch are served by the
# backend itself (no Firebase in the portal any more), so nothing else is
# needed here.

# Verified live hosting: admin.safetyalrt.com is served by AWS/nginx.
# It has no Pages Function. Call the configured live API directly.
# For a future custom-domain Pages deployment, set VITE_USE_RELAY=true in
# that Pages build environment AND API_ORIGIN=https://api.safetyalrt.com.
VITE_USE_RELAY=false

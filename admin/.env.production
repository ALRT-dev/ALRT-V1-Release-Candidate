# Admin Portal build settings for the LIVE portal (admin.safetyalrt.com).
# Loaded automatically by `npm run build` (Vite's default "production" mode).
# Public values only - nothing here is a secret, and none may ever be added.

# Live backend Admin API. No trailing slash.
VITE_API_BASE_URL=https://api.safetyalrt.com

# TEST-only buttons stay OFF in the live portal. Do not change.
VITE_ENABLE_DUMMY_ALERTS=
VITE_ENABLE_REAL_SOURCE_SYNC=

# Ask ALRT page (optional). Public Firebase Web App identifiers for project
# alrt-a6539 - fill in once a Web App is registered in the Firebase console
# (Project settings -> Your apps -> Web). Blank = the page shows
# "not configured" instead of failing.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=alrt-a6539.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=alrt-a6539
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=705221000399
VITE_FIREBASE_APP_CHECK_SITE_KEY=

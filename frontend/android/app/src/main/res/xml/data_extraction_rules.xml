<?xml version="1.0" encoding="utf-8"?>
<!-- Sign-in tokens and app settings never leave the phone in a cloud backup
     or a device-to-device transfer (Android 12+). allowBackup="false" covers
     older versions. -->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" />
    <exclude domain="sharedpref" />
    <exclude domain="database" />
    <exclude domain="file" />
    <exclude domain="external" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" />
    <exclude domain="sharedpref" />
    <exclude domain="database" />
    <exclude domain="file" />
    <exclude domain="external" />
  </device-transfer>
</data-extraction-rules>

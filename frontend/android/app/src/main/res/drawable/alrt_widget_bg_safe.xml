<?xml version="1.0" encoding="utf-8"?>
<!-- "Everyone's safe" card: the same bright green -> teal gradient as the
     in-app I'm Safe action, so the widget's safe state reads as the same
     colour as the button that produced it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#059669"
        android:endColor="#2DD4A7" />
    <corners android:radius="18dp" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!-- Compact (1-cell-high) variant of the Family circles widget: one summary
     line across every circle. Same header/summary ids as the full layout so
     the provider binds either. Row and "more" views are absent here; the
     provider checks for them before binding. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/family_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/alrt_widget_bg_purple"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="10dp"
        android:src="@mipmap/ic_launcher"
        android:scaleType="fitCenter"
        android:contentDescription="ALRT" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/family_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/family_kicker"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#D9D0F7"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/family_freshness"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#CFC7EC"
                android:textSize="9sp"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/family_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/family_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#CFC7EC"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>

default_platform(:ios)

platform :ios do
  require 'date'

  my_release_note = <<~NOTE
    * UI Updates
  NOTE

  desc "Automatically increment the version name and version code. Also prepare the changelogs and release note from git commits."
  lane :auto_versioning do
    # Increment the version code and version name in pubspec.yaml
    pubspec_path = '../../pubspec.yaml'
    # version_name = increment_version_name(pubspec_path) # Eg. 1.0.0
    version_name = "1.0.1"
    version_code = increment_version_code(pubspec_path) # Eg. 23

    # Generate 2 files: CHANGELOG.md and release_notes.txt from git commits
    generateChangeLogAndReleaseNote(version_name, version_code, my_release_note)

    # Add a new git tag with the updated version name nad code
    add_git_tag(
      tag: "v#{version_name}+#{version_code}"
    )
  end

  desc 'Deploy the DEV application to Firebase App Distribution (iOS)'
  lane :firebase_dev do
    sh 'fvm flutter build ipa --flavor dev -t lib/main_dev.dart'
    firebase_app_distribution(
      app: "1:841565771679:ios:9b500f20dcdaa31dde0faa",
      release_notes_file: '../release_note.txt',
      ipa_path: "../build/ios/ipa/[Dev] ALRT.ipa",
      groups: 'alrt',
    )
  end

  desc 'Deploy the PROD application to Firebase App Distribution (iOS)'
  lane :firebase_prod do
    # sh 'fvm flutter build ipa --flavor prod -t lib/main_prod.dart'
    firebase_app_distribution(
      app: "1:841565771679:ios:45b8377b1d906f78de0faa",
      release_notes_file: '../release_note.txt',
      ipa_path: "../build/ios/ipa/ALRT.ipa",
      groups: 'alrt',
    )
  end

  desc "Deploy the PROD application to TestFlight"
  lane :beta_release do
    sh 'flutter build ipa --flavor prod -t lib/main_prod.dart'
    upload_to_testflight(
      changelog: my_release_note,
      ipa: "../build/ios/ipa/ALRT.ipa"
    )
  end

  # ---- Lanes below are for GitHub Actions (ios-testflight.yml): they build and
  # ---- upload on a rented cloud Mac, so no physical Mac is needed. They expect
  # ---- APP_STORE_CONNECT_API_KEY_ID / _ISSUER_ID / _KEY_CONTENT and the
  # ---- MATCH_GIT_URL / MATCH_GIT_BASIC_AUTHORIZATION / MATCH_PASSWORD env vars.

  desc "CI: install the App Store signing certificate and profile on the runner"
  lane :ci_certs do |options|
    setup_ci
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true
    )
    # readonly unless the run explicitly asks to (re)generate certificates,
    # so an ordinary build can never revoke or churn the team's signing assets.
    match(
      type: "appstore",
      readonly: options[:generate].to_s != "true",
      api_key: api_key
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      targets: ["Runner"],
      team_id: "JR89M7CYPR",
      bundle_identifier: "com.safetyalrt.alrt",
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore com.safetyalrt.alrt"
    )
  end

  desc "CI: install the App Store signing certificate and profile for the isolated TEST (dev-flavour) app on the runner"
  lane :ci_certs_dev do |options|
    # Same as ci_certs above, targeting the separate "ALRT Dev" App Store
    # Connect app (com.safetyalrt.alrt.dev) instead of production. Never
    # merged into ci_certs - the two must stay independently invocable so a
    # TEST pipeline change can never affect the production signing lane.
    setup_ci
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true
    )
    match(
      type: "appstore",
      readonly: options[:generate].to_s != "true",
      api_key: api_key,
      app_identifier: "com.safetyalrt.alrt.dev"
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      targets: ["Runner"],
      team_id: "JR89M7CYPR",
      bundle_identifier: "com.safetyalrt.alrt.dev",
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore com.safetyalrt.alrt.dev"
    )
  end

  desc "CI: upload the already-built ipa (IPA_PATH env, absolute) to TestFlight"
  lane :ci_upload do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true
    )
    upload_to_testflight(
      api_key: api_key,
      ipa: ENV.fetch("IPA_PATH"),
      changelog: my_release_note,
      skip_waiting_for_build_processing: true
    )
  end

  desc "CI: upload the already-built TEST (dev-flavour) ipa to the separate ALRT Dev TestFlight app - never the live ALRT app"
  lane :ci_upload_dev do
    # Same as ci_upload, with the App Store Connect record pinned explicitly.
    # Without app_identifier, pilot falls back to the Appfile default -
    # com.safetyalrt.alrt, the LIVE app - looks that record up, and tries to
    # push a .dev ipa into it (Apple rejects the bundle-id mismatch, so the
    # TEST upload would fail every time, but it must never even be
    # attempted). Kept separate from ci_upload so the production upload lane
    # is byte-for-byte unchanged.
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true
    )
    ipa_path = ENV.fetch("IPA_PATH")
    ipa_bundle_id = FastlaneCore::IpaFileAnalyser.fetch_app_identifier(ipa_path)
    UI.user_error!("ci_upload_dev refuses to upload '#{ipa_bundle_id}' - only com.safetyalrt.alrt.dev may go to ALRT Dev") unless ipa_bundle_id == "com.safetyalrt.alrt.dev"
    upload_to_testflight(
      api_key: api_key,
      app_identifier: "com.safetyalrt.alrt.dev",
      ipa: ipa_path,
      changelog: "TEST build - isolated api-test backend",
      skip_waiting_for_build_processing: true
    )
  end

  desc "Uploads the dSYM files to Crashlytics"
  lane :upload_dsym do
    upload_symbols_to_crashlytics(
      gsp_path: "./config/prod/GoogleService-Info.plist"
    )
  end

  # -------------------------------------- HELPERS --------------------------------------
  
  def increment_version_code(pubspec_path)
    content = File.read(pubspec_path)
    version_line = content.lines.find { |line| line.start_with?("version:") }
    current_version = version_line.split("version:").last.strip
    version_name, version_code = current_version.split('+')
    new_version_code = version_code.to_i + 1
    new_version = "#{version_name}+#{new_version_code}"
    new_content = content.gsub(/version: .*/, "version: #{new_version}")
    File.write(pubspec_path, new_content)
    return new_version_code
  end

  def increment_version_name(pubspec_path)
    content = File.read(pubspec_path)
    version_line = content.lines.find { |line| line.start_with?("version:") }
    current_version = version_line.split("version:").last.strip
    version_name, version_code = current_version.split('+')
    version_parts = version_name.split('.').map(&:to_i)
    version_parts[-1] += 1
    new_version_name = version_parts.join('.')
    new_version = "#{new_version_name}+#{version_code}"
    new_content = content.gsub(/version: .*/, "version: #{new_version}")
    File.write(pubspec_path, new_content)
    return new_version_name
  end

  def generateChangeLogAndReleaseNote(version_name, version_code, release_note = nil)
    current_date = Date.today.strftime("%Y/%m/%d")
  
    if release_note.nil? || release_note.strip.empty?
      last_tag = last_git_tag
      if last_tag.nil? || last_tag.empty?
        last_tag = "HEAD~1"
      end
  
      changelog = changelog_from_git_commits(
        between: [last_tag, 'Head'],
        pretty: "* %s"
      )
    else
      changelog = release_note
    end
  
    changelog_file_path = "../../CHANGELOG.md"
    release_notes_file_path = "../../release_note.txt"
  
    existing_content = File.exist?(changelog_file_path) ? File.read(changelog_file_path) : ""
    new_entry = "## v#{version_name}+#{version_code} - #{current_date}\n#{changelog}\n\n"
    updated_content = new_entry + existing_content
  
    # Write CHANGELOG.md
    File.write(changelog_file_path, updated_content)
  
    # Write release_note.txt
    File.write(release_notes_file_path, changelog)
  end
end

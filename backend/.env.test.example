# Template for the ISOLATED INTERNAL-TEST backend deployment (Stage A of the
# internal-test-environment project, V1_RECONCILIATION_REPORT.md).
#
# Copy this file to `.env.test` (gitignored, never committed - same pattern
# as .env.dev/.env.prod being copied from .env.default) and fill in real
# values for your test deployment. This file must NEVER be committed with
# real values.
#
# THE ONE RULE THAT MAKES THIS SAFE: DATABASE_URL below must point at a
# database that has never been used by production and never will be -
# never copy the production DATABASE_URL secret into this file or into
# whatever hosting platform serves this deployment. See
# backend/docs/TEST_ENVIRONMENT.md for the full isolation checklist.
#
# NODE_ENV is deliberately "test", not "prod" - this repo's own code
# (backend/src/index.ts) only runs the in-process scheduled jobs
# (hazard ingestion, expiry sweeps, check-ins) when NODE_ENV=prod. On this
# environment, trigger ingestion manually instead: Admin Portal -> Sources
# -> Sync, or POST /api/admin/hazards/sync-external. Do not set NODE_ENV=prod
# here just to get ingestion running automatically - see the doc above for
# why.
NODE_ENV=test
PORT=

TRUST_PROXY=
API_RATE_LIMIT_WINDOW_MS=
API_RATE_LIMIT_MAX=
AUTH_RATE_LIMIT_WINDOW_MS=
AUTH_RATE_LIMIT_MAX=
HAZARD_GET_IP_RATE_LIMIT_WINDOW_MS=
HAZARD_GET_IP_RATE_LIMIT_MAX=
HAZARD_READ_RATE_LIMIT_WINDOW_MS=
HAZARD_READ_RATE_LIMIT_MAX=
MAPS_PROXY_RATE_LIMIT_WINDOW_MS=
MAPS_PROXY_RATE_LIMIT_MAX=

# Must include the test Admin Portal's real domain once deployed (Stage A
# item 5) and nothing else - never add the production Admin Portal's domain
# here.
CORS_ALLOWED_ORIGINS=

# MUST be a database dedicated to this test deployment - a fresh instance,
# never the production database, never a schema/tenant inside the same
# instance as production. See docker-compose.test.yml for a local example.
DATABASE_URL=

# Independent secrets from production - generate fresh values, never reuse
# the production JWT secrets (a shared secret would let a token minted by
# one environment authenticate against the other).
JWT_ACCESS_SECRET=
JWT_ACCESS_EXP_M=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXP_D=

ADMIN_JWT_ACCESS_SECRET=
ADMIN_JWT_ACCESS_EXP_M=
ADMIN_JWT_REFRESH_SECRET=
ADMIN_JWT_REFRESH_EXP_D=

# The dedicated test super-admin, created against THIS database only by
# running `npx tsx src/scripts/create-super-admin.ts` against .env.test.
# Use an email that is obviously test-only (e.g. a distinct local-part or
# a +test tag) - never reuse a real production admin's email here.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=

WEBHOOK_KEY_OUTPUT_FILE=

# Not wired to production RevenueCat in Stage A - real purchase-flow
# testing is a later stage. Leave blank or use a value that will never
# match a real RevenueCat webhook call.
REVENUECAT_WEBHOOK_AUTH=
ADMIN_PASSWORD_OUTPUT_FILE=

# Safe to reuse the same values as production - these are OAuth client IDs
# (public identifiers), not secrets, and Google/Apple validate the token
# regardless of which ALRT backend receives it afterwards.
GOOGLE_OAUTH_CLIENT_ID_WEB=
GOOGLE_OAUTH_CLIENT_ID_IOS=
GOOGLE_OAUTH_CLIENT_ID_ANDROID=

APPLE_OAUTH_AUDIENCE=

MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT_ID=

OPENAI_API_KEY=

AWS_S3_REGION=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_CLOUDFRONT_DOMAIN=

AWS_BEDROCK_REGION=
AWS_BEDROCK_ACCESS_KEY_ID=
AWS_BEDROCK_SECRET_ACCESS_KEY=
AWS_BEDROCK_FALLBACK_MODEL_ID=

NSW_TRANSPORT_API_KEY=
WAQI_API_TOKEN=
QLD_TRAFFIC_API_KEY=

# Safe to reuse the existing ALRT App key for now (Stage A does not touch
# Google Maps key restriction/migration - that is a separate, later stage).
GOOGLE_MAPS_API_KEY=

SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
SIGHTENGINE_WORKFLOW_ID=

CACHE_URL=
CACHE_TLS=

PASSWORD_RESET_BASE_URL=

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_SUPPORT_ADDRESS=
EMAIL_SUPPORT_CC_ADDRESSES=

# MUST stay false on this environment for Stage A. Real purchase-flow
# testing (a later stage) still would not need this true - RevenueCat
# webhook events flip User.plan directly regardless of this flag; this
# only gates whether the *enforcement* (seat/location caps) is live.
BILLING_ENABLED=false

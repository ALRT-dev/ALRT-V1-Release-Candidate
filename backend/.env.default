JWT_ACCESS_SECRET=
JWT_ACCESS_EXP_M=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXP_D=

ADMIN_JWT_ACCESS_SECRET=
ADMIN_JWT_ACCESS_EXP_M=
ADMIN_JWT_REFRESH_SECRET=
ADMIN_JWT_REFRESH_EXP_D=

SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=

# CLI scripts: write one-time secrets to a file instead of captured stdout (CI / log drains)
WEBHOOK_KEY_OUTPUT_FILE=

REVENUECAT_WEBHOOK_AUTH=
ADMIN_PASSWORD_OUTPUT_FILE=

GOOGLE_OAUTH_CLIENT_ID_WEB=
GOOGLE_OAUTH_CLIENT_ID_IOS=
GOOGLE_OAUTH_CLIENT_ID_ANDROID=

APPLE_OAUTH_AUDIENCE=

MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_TENANT_ID=

OPENAI_API_KEY=

AWS_S3_REGION=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_CLOUDFRONT_DOMAIN=

AWS_BEDROCK_REGION=
AWS_BEDROCK_ACCESS_KEY_ID=
AWS_BEDROCK_SECRET_ACCESS_KEY=
AWS_BEDROCK_FALLBACK_MODEL_ID=

NSW_TRANSPORT_API_KEY=
WAQI_API_TOKEN=
QLD_TRAFFIC_API_KEY=

GOOGLE_MAPS_API_KEY=

SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
SIGHTENGINE_WORKFLOW_ID=

CACHE_URL=
CACHE_TLS=

# Optional: pins password-reset email links to this origin instead of the
# incoming request's own host. e.g. https://app.safetyalrt.com
PASSWORD_RESET_BASE_URL=

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_SUPPORT_ADDRESS=
EMAIL_SUPPORT_CC_ADDRESSES=

# Entitlements. Until this is "true" every account counts as ALRT+ server-side:
# circle-hosting and saved-location caps do not bite, and RevenueCat webhooks
# still record plan changes without enforcing them. Flip to "true" at billing
# launch or paid and unpaid users are identical on the server.
BILLING_ENABLED=

# Free-trial record: secret used to hash emails (one-way) so a person can
# start only one free trial. Leave blank and it falls back to
# JWT_ACCESS_SECRET (a startup warning says so); set a dedicated value before
# JWT_ACCESS_SECRET is ever rotated, or earlier trials stop being recognised.
TRIAL_LEDGER_SECRET=

# RevenueCat. Store product id -> tier, comma separated, no built-in ids:
#   productId:individual,productId:family,productId:group20,productId:group50
# An unmapped product is recorded and ignored.
RC_PRODUCT_TIERS=
# Optional: only accept webhook events from this RevenueCat environment
# (PRODUCTION or SANDBOX). Blank = accept both.
RC_EXPECTED_ENVIRONMENT=
# Optional: comma-separated RevenueCat app ids whose events are accepted.
# Blank = any app id.
RC_APP_IDS=
# Optional: RevenueCat secret (server) API key, used only to confirm pending
# plan changes and report purchases whose webhook has not arrived. Blank =
# that check is skipped. Never put this key in the app.
REVENUECAT_SECRET_API_KEY=

# Ask ALRT AI kill switch. "false" forces the AI fallback off whatever the
# Admin Portal says (library and emergency-number answers keep working).
# Blank = the Admin Portal setting decides (on by default).
ASK_ALRT_AI_ENABLED=

# Force-update policy served at GET /api/app/version-policy (public, no
# auth). The app shows its update screen when it is older than the minimum.
# Blank = no requirement for that platform (served as null).
# MIN_APP_VERSION_* is a dotted version (e.g. 1.4.0); MIN_APP_BUILD_* is a
# whole build number; APP_STORE_URL_* is the store page the update button opens.
MIN_APP_VERSION_IOS=
MIN_APP_BUILD_IOS=
APP_STORE_URL_IOS=
MIN_APP_VERSION_ANDROID=
MIN_APP_BUILD_ANDROID=
APP_STORE_URL_ANDROID=

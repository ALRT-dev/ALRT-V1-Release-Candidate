# =============================================================================
# ALRT LIVE (production) backend settings - TEMPLATE, NO REAL VALUES
# =============================================================================
#
# This file records every setting the live backend needs and WHERE each live
# value currently lives. It is safe to commit because it holds no secrets.
#
# On the live server, copy it to `.env.prod` (gitignored - never commit it;
# this repository is public) and fill in the blanks:
#
#     cp .env.prod.example .env.prod
#     bash scripts/fill-env-prod-from-aws.sh     # fills what AWS already holds
#     bash scripts/check-env-prod.sh             # lists anything still blank
#
# docker-compose.yml (app_blue / app_green) loads `.env.prod`.
# Full map of live connections and switch-on order: docs/LIVE_CONNECTIONS.md
#
# Where live values are, as observed 4 Oct 2026 (read-only, names only):
#   [ON SERVER]  only in the existing .env.prod on EC2 safety-alrt-prod
#                (i-0c7a10c5b1d74310d, account 082258816984, ap-southeast-2).
#                Copy across from that file - it is the source of truth.
#   [AWS SM]     AWS Secrets Manager, account 082258816984, ap-southeast-2.
#   [PROVIDER]   the provider's own dashboard (if the server copy is lost).
#   [SET]        not secret; the value below is the intended live value.
#   [CHOOSE]     a decision to make; recommended value given.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# [SET] "prod" runs the scheduled jobs (source sync every 15 min, expiry
# sweeps, check-ins, SOS auto-end, location purge). Never use "test" here.
NODE_ENV=prod
# [ON SERVER] container port; compose maps 127.0.0.1:3001/3002 -> 9000.
PORT=9000
# [ON SERVER] reverse proxy hops in front of the app.
TRUST_PROXY=

# [ON SERVER] rate limits - blank uses code defaults.
API_RATE_LIMIT_WINDOW_MS=
API_RATE_LIMIT_MAX=
AUTH_RATE_LIMIT_WINDOW_MS=
AUTH_RATE_LIMIT_MAX=
HAZARD_GET_IP_RATE_LIMIT_WINDOW_MS=
HAZARD_GET_IP_RATE_LIMIT_MAX=
HAZARD_READ_RATE_LIMIT_WINDOW_MS=
HAZARD_READ_RATE_LIMIT_MAX=
MAPS_PROXY_RATE_LIMIT_WINDOW_MS=
MAPS_PROXY_RATE_LIMIT_MAX=

# [SET] the live Admin Portal origin. Add any other real admin host here.
CORS_ALLOWED_ORIGINS=https://admin.safetyalrt.com

# --- Database ----------------------------------------------------------------
# [AWS SM] secret `safetyalrt/db/postgres`. Live database is the RDS
# PostgreSQL instance `alrt-app-db-dev` (despite the "dev" name it is the one
# in the production account - confirm with Matt before any migration).
# Format: postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
# NEVER point any test environment at this value.
DATABASE_URL=

# --- Sign-in tokens ----------------------------------------------------------
# [ON SERVER] keep the existing live values - changing them signs every user
# and every admin out.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXP_M=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXP_D=

ADMIN_JWT_ACCESS_SECRET=
ADMIN_JWT_ACCESS_EXP_M=
ADMIN_JWT_REFRESH_SECRET=
ADMIN_JWT_REFRESH_EXP_D=

# [ON SERVER] only used by scripts/create-super-admin.ts.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=

WEBHOOK_KEY_OUTPUT_FILE=
ADMIN_PASSWORD_OUTPUT_FILE=

# --- Subscriptions (RevenueCat) ----------------------------------------------
# [CHOOSE] generate a long random string, put it here AND in the RevenueCat
# dashboard webhook "Authorization header" for
# https://api.safetyalrt.com/api/revenuecat/webhook (same exact value).
REVENUECAT_WEBHOOK_AUTH=
# [SET] product id -> tier for the LIVE app (com.safetyalrt.alrt). These are
# the planned live ids (same ids on Apple and Google). Products not yet
# created in a store are simply ignored until they exist. Never add the
# alrt_dev_* ids here - those belong to the Dev app and TEST only.
RC_PRODUCT_TIERS=alrt_individual_monthly:individual,alrt_family_monthly:family,alrt_group20_monthly:group20,alrt_group50_monthly:group50
# [PROVIDER] RevenueCat app ids for the LIVE Apple and Google apps, comma
# separated (RevenueCat -> Project settings -> Apps). app71b0055bd7 and
# appd3e61acd3b were recorded during Dev/TEST setup - confirm which apps they
# are before reusing them here.
RC_APP_IDS=
# [SET] live receives real purchases.
RC_EXPECTED_ENVIRONMENT=PRODUCTION
# [PROVIDER] RevenueCat secret API key (sk_...). Server only - never in the app.
REVENUECAT_SECRET_API_KEY=
# [CHOOSE] keep "false" until one real purchase has been traced end to end
# (store -> RevenueCat -> this backend -> /api/access). Then "true".
BILLING_ENABLED=false

# --- Social sign-in (public client ids, not secrets) --------------------------
# [ON SERVER] / [PROVIDER] Google Cloud console -> Credentials.
GOOGLE_OAUTH_CLIENT_ID_WEB=
GOOGLE_OAUTH_CLIENT_ID_IOS=
GOOGLE_OAUTH_CLIENT_ID_ANDROID=
# [ON SERVER] / [PROVIDER] Apple Developer -> bundle id / Services ID.
APPLE_OAUTH_AUDIENCE=
# Optional Microsoft sign-in.
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_TENANT_ID=

# --- AI ----------------------------------------------------------------------
# [SET] bedrock is the default provider. OPENAI_API_KEY is still required at
# startup by config.ts even when bedrock is used.
AI_PROVIDER=bedrock
# [ON SERVER] / [PROVIDER] platform.openai.com
OPENAI_API_KEY=
# [SET] Bedrock uses the EC2 instance role (safety-alrt-prod-instance-role)
# when the key fields are blank.
AWS_BEDROCK_REGION=ap-southeast-2
AWS_BEDROCK_ACCESS_KEY_ID=
AWS_BEDROCK_SECRET_ACCESS_KEY=
AWS_BEDROCK_FALLBACK_MODEL_ID=

# --- Photo / video storage ---------------------------------------------------
# [SET] live bucket observed in account 082258816984.
AWS_S3_REGION=ap-southeast-2
AWS_S3_BUCKET_NAME=alrt-app-bucket
# [AWS SM] secret `safety-alert/aws-credentials` (or the existing .env.prod).
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
# Optional CDN domain; blank = direct S3 URLs.
AWS_CLOUDFRONT_DOMAIN=

# --- Alert feeds -------------------------------------------------------------
# [ON SERVER] / [PROVIDER] opendata.transport.nsw.gov.au - required at startup.
NSW_TRANSPORT_API_KEY=
# [ON SERVER] / [PROVIDER] aqicn.org/data-platform/token - required at startup.
WAQI_API_TOKEN=
# [ON SERVER] optional - the QLD traffic feed is skipped when blank.
QLD_TRAFFIC_API_KEY=

# --- Maps --------------------------------------------------------------------
# [AWS SM] secret `GOOGLE_MAPS_API_KEY` (also read at runtime from
# `safety-alert-prod/api-token` via the Secrets Manager agent when present).
GOOGLE_MAPS_API_KEY=
MAPS_API_KEY_SECRET_ID=safety-alert-prod/api-token
MAPS_API_KEY_SECRET_ENV_KEY=GOOGLE_MAPS_API_KEY

# --- Image moderation --------------------------------------------------------
# [ON SERVER] / [PROVIDER] sightengine.com dashboard - required at startup.
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
SIGHTENGINE_WORKFLOW_ID=

# --- Cache (optional) --------------------------------------------------------
CACHE_URL=
CACHE_TLS=

# --- Email -------------------------------------------------------------------
# [SET] where password-reset links point.
PASSWORD_RESET_BASE_URL=
# [ON SERVER] / [PROVIDER] SMTP provider (Amazon SES appears among this
# account's recently used services - confirm it is the live provider).
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_SUPPORT_ADDRESS=
EMAIL_SUPPORT_CC_ADDRESSES=

#!/usr/bin/env bash
# stand-in for curl: IMDS + health endpoints, driven by SCENARIO
args="$*"
case "$args" in
  *"/latest/api/token"*) echo "tok";;
  *"/meta-data/instance-id"*) echo "${FAKE_INSTANCE:-i-0045a41694e315d45}";;
  *"/meta-data/placement/region"*) echo "${FAKE_REGION:-ap-southeast-2}";;
  *"127.0.0.1:3010/api/test"*) if [ "${SCENARIO:-}" = "startup-fail" ] || [ "${SCENARIO:-}" = "health-fail" ]; then exit 22; fi; if [[ "$args" == *"-w"* ]]; then printf '200'; else echo "Test route is working!"; fi;;
  *"api-test.safetyalrt.com"*) if [ "${SCENARIO:-}" = "external-fail" ]; then printf '000'; exit 0; fi; printf '200';;
  *) exit 1;;
esac
